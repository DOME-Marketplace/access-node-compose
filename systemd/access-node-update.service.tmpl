[Unit]
Description=Dome Access Node Compose - check for updates and restart stack if needed
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# The user that installed the node (it must be able to run docker): files written
# by the updates stay owned by that user instead of root.
User=__USER__
WorkingDirectory=__WORKDIR__
ExecStart=__WORKDIR__/update.sh
