# Credentials of the S3-compatible object storage (SeaweedFS service), where
# tm-forum-api-document-management stores document attachments.
# Copy this file to .env.s3 (wizard.py step 2 does it for you) and change the values.
#
# The storage is never exposed to the Internet: it is reachable only from the
# access-node Docker network and from this host (127.0.0.1).

# Keys document-management uses to access the S3 API (127.0.0.1:8333 on this host).
# Use only letters, digits, '.', '_' or '-': SeaweedFS refuses to start otherwise.
# Changing them later is fine: both services read them from this file at startup
# (recreate them with ./wizard.py 5).
S3_ACCESS_KEY=document-management
S3_SECRET_KEY=changeme-s3-secret-key

# Login of the SeaweedFS admin web UI (file browser, metrics): http://127.0.0.1:12535
# on this host, e.g. through an SSH tunnel: ssh -L 12535:127.0.0.1:12535 <this-host>
# If SEAWEEDFS_ADMIN_PASSWORD is empty, the admin UI is not reachable from outside
# the container. Don't create S3 users from the admin UI: the S3 keys above are the
# only ones document-management uses.
SEAWEEDFS_ADMIN_USER=admin
SEAWEEDFS_ADMIN_PASSWORD=changeme-admin-password
